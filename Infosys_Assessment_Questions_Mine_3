import java.util.*;
class Main {
    public static long solve(int n, int f, int max, int[] s) {
        int limit = Math.min(n, f + 1);
        long[] dp = new long[limit];

        Deque<Integer> dq = new ArrayDeque<>();
        dp[0] = s[0];
        dq.add(0);

        for (int i = 1; i < limit; i++) {
            while (!dq.isEmpty() && dq.peekFirst() < i - max)
                dq.pollFirst();

            dp[i] = s[i] + dp[dq.peekFirst()];

            while (!dq.isEmpty() && dp[dq.peekLast()] <= dp[i])
                dq.pollLast();

            dq.add(i);
        }

        long ans = Long.MIN_VALUE;
        for (long v : dp) ans = Math.max(ans, v);

        return ans;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(), f = sc.nextInt(), max = sc.nextInt();
        int[] s = new int[n];
        for (int i = 0; i < n; i++) s[i] = sc.nextInt();
        System.out.println(solve(n, f, max, s));
    }
}

