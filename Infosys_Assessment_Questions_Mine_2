import java.util.*;

class Main {
    public static int solve(int n, int k, int[] a) {
        if (n == 0) return 0;
        int[][] dp = new int[k + 1][n + 1];
        
        for (int m = 1; m <= k; m++) {
            for (int i = 1; i <= n; i++) {
                Map<Integer, Integer> counts = new HashMap<>();
                int curMax = 0;
                for (int j = i; j >= 1; j--) {
                    int val = a[j - 1];
                    int count = counts.getOrDefault(val, 0) + 1;
                    counts.put(val, count);
                    curMax = Math.max(curMax, count);
                    
                    if (m == 1) {
                        if (j == 1) dp[m][i] = curMax;
                    } else {
                        if (j > 1 && dp[m - 1][j - 1] > 0) {
                            dp[m][i] = Math.max(dp[m][i], dp[m - 1][j - 1] + curMax);
                        }
                    }
                }
            }
        }
        return dp[k][n];
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        int n = sc.nextInt();
        int k = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        int result = solve(n, k, a);
        System.out.println(result);
    }
}

