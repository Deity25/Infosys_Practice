import java.util.*;

class Main {
    public static int solve(int n, int x, int k) {
        long MOD = 1000000007L, P = 1000000009L;

        List<Integer> factors = new ArrayList<>();
        int temp = x;

        for (int i = 2; i * i <= temp; i++) {
            while (temp % i == 0) {
                factors.add(i);
                temp /= i;
            }
        }
        if (temp > 1) factors.add(temp);

        if (factors.size() < k) return -1;

        int[] seg = new int[k];
        Arrays.fill(seg, 1);

        for (int f : factors) {
            int idx = 0;
            for (int i = 1; i < k; i++)
                if (seg[i] < seg[idx]) idx = i;

            seg[idx] *= f;
        }

        for (int v : seg) if (v < 2) return -1;

        Arrays.sort(seg);

        long sum = 0, pPow = 1, pMod = P % MOD;

        for (int i = 0; i < n; i++) {
            sum = (sum + seg[i % k] * pPow % MOD) % MOD;
            pPow = (pPow * pMod) % MOD;
        }

        return (int) sum;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(), x = sc.nextInt(), k = sc.nextInt();
        System.out.println(solve(n, x, k));
    }
}



